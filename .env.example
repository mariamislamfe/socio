# Copy to .env.local (never commit it). Every variable is optional for local development:
# without them Socio runs on an embedded Postgres and shows each integration as "server setup required".

# ---- Supabase (production / hosted) -------------------------------------
# When all three are set, Socio uses Supabase Auth + your Supabase Postgres.
# Supabase dashboard > Project Settings > API (URL + anon/publishable key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase dashboard > Connect > Connection string ("Transaction pooler"), with your database password filled in.
# Server-only. The service-role key is NOT used and must not be added here.
SUPABASE_DB_URL=

# ---- App ---------------------------------------------------------------
# Public HTTPS origin in production (used for OAuth redirects and webhook addresses).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 32 random bytes, base64. Encrypts provider tokens at rest. REQUIRED in production; keep it stable (changing it
# makes stored tokens unreadable and every store must reconnect). Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MARGIN_ENCRYPTION_KEY=

# ---- Background work ----------------------------------------------------
# On a long-running Node server the in-process worker runs jobs every few seconds (default).
# On serverless hosts set MARGIN_WORKER=off and call POST /api/cron/tick every 1–5 minutes with
#   Authorization: Bearer $CRON_SECRET     (Vercel Cron sends this header automatically when CRON_SECRET is set)
MARGIN_WORKER=
CRON_SECRET=

# ---- Shopify (Dev Dashboard app) ----------------------------------------
# dev.shopify.com > Apps > your app > Settings: Client ID and Client secret.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_SCOPES=read_orders,read_products,read_inventory
SHOPIFY_API_VERSION=2026-07
# Development/testing only: send Shopify API calls to a local fake (scripts/fake-shopify.mts). Ignored in production.
SHOPIFY_DEV_API_ORIGIN=

# ---- Meta Ads ------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v21.0
# Read-only by default. For the media buyer (create, start, pause ads) request:
#   ads_read,ads_management,pages_show_list,pages_manage_ads   (Advanced Access needs Meta App Review for other people's accounts)
META_SCOPES=ads_read
# Development/testing only: point at scripts/fake-meta.mts (ignored in production)
META_API_BASE=

# ---- Google Ads ----------------------------------------------------------
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=

# ---- Email (payment reminders) ---------------------------------------------
# Resend (resend.com > API Keys). Without both, reminders become drafts you send yourself.
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "Nile & Co <billing@yourdomain.com>"
EMAIL_FROM=

# ---- AI (Claude API; billed separately from a Claude Pro/Max subscription) --
# console.anthropic.com > API Keys. Without it: Boardroom says "not configured"; everything else works.
ANTHROPIC_API_KEY=
# Optional overrides: model ids, or a proxy / local test double for the API.
ANTHROPIC_MODEL=
BOARDROOM_MODEL=
# Model for "Ask your business" (tool use). Without a key it answers with the built-in planner.
AGENT_MODEL=
ANTHROPIC_BASE_URL=

# ---- WhatsApp morning briefing (Meta WhatsApp Cloud API) -------------------------
# business.facebook.com > WhatsApp Manager: a business phone number, a permanent system-user token, and an approved
# Utility template named WHATSAPP_TEMPLATE with 4 body variables ({{1}} name, {{2}} headline, {{3}} cash, {{4}} focus),
# in English (en) and/or Arabic (ar). Without these, nothing is sent and the UI says so.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=daily_briefing
WHATSAPP_API_VERSION=v23.0
# Recording money by message ("دفعت 500 شحن"): webhook <APP_URL>/api/webhooks/whatsapp, subscribed to "messages".
# App secret = Meta app > Settings > Basic (verifies X-Hub-Signature-256); verify token = any random string you also type in Meta.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Development/testing only: point at scripts/fake-whatsapp.mts
WHATSAPP_API_BASE=
